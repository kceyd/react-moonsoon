{
  "info": {
    "name": "moonsoon API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar en orden: Auth -> Usuarios -> Productos (Collection Runner)."
  },
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Registro cliente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{usuariosUrl}}/api/auth/registro",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Cliente Demo\",\n  \"email\": \"cliente@moonsoon.cl\",\n  \"password\": \"cliente123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 creado o 400 si ya existe\", function () { pm.expect([201,400]).to.include(pm.response.code); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Login ADMIN (guarda tokenAdmin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{usuariosUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@moonsoon.cl\",\n  \"password\": \"Admin123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código 200\", function () { pm.response.to.have.status(200); });",
                  "pm.collectionVariables.set(\"tokenAdmin\", pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login CLIENTE (guarda tokenCliente)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{usuariosUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"cliente@moonsoon.cl\",\n  \"password\": \"cliente123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código 200\", function () { pm.response.to.have.status(200); });",
                  "pm.collectionVariables.set(\"tokenCliente\", pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login con clave incorrecta (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{usuariosUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@moonsoon.cl\",\n  \"password\": \"mala\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código 401\", function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ]
        }
      ]
    },
